name: Verify Human Identity

on:
  workflow_dispatch:
    inputs:
      agent_name:
        description: "Agent name"
        required: true
        default: "Ken2121"
      agent_description:
        description: "Agent description"
        required: true
        default: "Ken2121 AI Agent"

jobs:
  verify:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repo
        uses: actions/checkout@v3

      - name: Setup Node
        uses: actions/setup-node@v3
        with:
          node-version: "20"

      - name: Install ClawHub
        run: npx clawhub@latest install verified-agent-identity

      - name: Install dependencies
        run: |
          cd script
          npm install

      - name: Create Ethereum Identity
        run: node scripts/createNewEthereumIdentity.js

      - name: Link Human to Agent
        run: |
          node scripts/manualLinkHumanToAgent.js --challenge '{"name":"Ken2121","description":"Ken2121 AI Agent"}'
